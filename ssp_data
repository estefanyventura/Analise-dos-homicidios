sp23 <- read.xlsx("SPDadosCriminais_2023.xlsx", sheet = 2, detectDates = TRUE)

sp23.2 <- read.xlsx("SPDadosCriminais_2023.xlsx", sheet = 3, detectDates = TRUE)

sp23.2 <- sp23.2 %>%
  mutate(
    DATA_REGISTRO = as.character(DATA_REGISTRO),
    DATA_OCORRENCIA_BO = as.character(DATA_OCORRENCIA_BO)
  )

# Juntar os semestres
sp_23 <- bind_rows(sp23, sp23.2)

# Filtrar homicídios dolosos e contar por mês estatístico
homicidio_sp23 <- sp_23 %>%
  filter(
    ANO_ESTATISTICA == 2023,
    NATUREZA_APURADA %in% c(
      "HOMICÍDIO DOLOSO",
      "HOMICÍDIO DOLOSO POR ACIDENTE DE TRÂNSITO"
    )
  ) %>%
  count(MES_ESTATISTICA, name = "n_casos") %>%
  arrange(MES_ESTATISTICA) %>%
  mutate(
    mes_ano = factor(
      MES_ESTATISTICA,
      levels = 1:12,
      labels = c(
        "01/2023", "02/2023", "03/2023", "04/2023",
        "05/2023", "06/2023", "07/2023", "08/2023",
        "09/2023", "10/2023", "11/2023", "12/2023"
      )
    )
  )

# Conferir os resultados
print(homicidio_sp23)

# Conferir o total anual
sum(homicidio_sp23$n_casos)








